---
import { Image } from 'astro:assets';
import logo from '../assets/logo-lbbc.png'
---

<header class="header">
  <div class="logo">
    <a href="/">
      <Image src={logo} alt="Smyrna BBC Stockholm Logo" />
    </a>
  </div>

  <!-- Hamburger: hidden on desktop -->
  <button
    class="menu-toggle"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="primary-nav"
  >
    ☰
  </button>

  <nav id="primary-nav" class="main-nav" data-collapsed="true">
    <ul>
      <li><a href="/what-we-believe">What we believe</a></li>
      <li><a href="/salvation">Bible way to Heaven</a></li>
      <li><a href="/materials">Materials</a></li>
      <li><a href="/prayer-requests">Prayer Requests</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: relative;
    display: flex;
    justify-content: end;
    align-items: center;
    padding: 1.5rem 3rem;
    background-color: var(--navy);
  }

  .logo {position: absolute; top: 1rem; left: 1rem;}

  .logo img {height: 100px; width: 100px; }

  /* Desktop nav */
  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
  }
  .main-nav a {
    text-decoration: none;
    color: white;
    font-weight: bold;
    font-size: 1.1rem;
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .main-nav a:hover { 
    color: var(--light-gray); 
    text-decoration: underline;
  }

  /* Hamburger hidden on desktop */
  .menu-toggle {
    display: none;
    font-size: 2rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--light-gray);
  }

  /* --- Mobile styles --- */
  @media (max-width: 768px) {
    .header { padding: 1rem 1.25rem; }

    .menu-toggle { display: block; }

    .main-nav {
      position: absolute;
      top: 64px;          /* just below header */
      right: 0;
      left: 0;
      background-color: var(--light-gray);
      display: none;      /* hidden by default on mobile */
      padding: 1rem 1.25rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .main-nav ul {
      flex-direction: column;
      gap: 1rem;
    }

    /* When opened via data attribute */
    .main-nav[data-collapsed="false"] {
      display: block;
    }
  }
</style>

<script>
  // Tiny vanilla JS to toggle the mobile menu
  const btn = document.querySelector('.menu-toggle');
  const nav = document.getElementById('primary-nav');

  if (btn && nav) {
    btn.addEventListener('click', () => {
      const isCollapsed = nav.getAttribute('data-collapsed') !== 'false';
      
      nav.setAttribute('data-collapsed', isCollapsed ? 'false' : 'true');
      btn.setAttribute('aria-expanded', String(isCollapsed));
    });
  }
</script>
