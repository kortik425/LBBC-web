---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  subtitle?: string;
  content: string;
}
const { title, subtitle, content } = Astro.props;
---

<Layout title={title}>
  <section class="hero">
    <h1>{subtitle ?? title}</h1>
    <p>
      {content}
    </p>
  </section>
  <slot />
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--parchment);
    color: var(--navy);
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .hero p {
    font-size: 1.2rem;
    max-width: 700px;
    margin: 0 auto;
  }
</style>
