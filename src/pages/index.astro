---
import BaseLayout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import group from "../assets/group.jpg";
import CalendarIcon from '../assets/icons/calendar.svg'
import LocationIcon from '../assets/icons/location.svg'
import WaterDrop from "../assets/water-drop.svg";
---

<BaseLayout title="Smyrna BBC Stockholm">
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">
        SHINING THE LIGHT OF <br />
        GOD'S GLORY TO THE WORLD
      </h1>
      <p class="hero-text">
        God's will is for people to be saved! Salvation is the free gift of God.
        He has prepared it for you!
      </p>
      <div class="cta-buttons">
        <a href="/salvation" class="button cta primary"
          >Check out how to be saved!</a
        >
        <a href="/what-we-believe" class="button secondary"
          >Find out our core beliefs!</a
        >
      </div>
      <div class="join-info">
        <h3>What to expect upon joining:</h3>
        <ul>
          <li class="list-element">
            <WaterDrop /> Uncompromised Biblical teaching
          </li>
          <li class="list-element"><WaterDrop /> Close family fellowship</li>
          <li class="list-element">
            <WaterDrop /> Solemn, old fashioned worship
          </li>
        </ul>
      </div>
    </div>
    <div class="hero-image">
      {/* You can replace this with your own image */}
      <Image src={group} alt="LBBC group picture" />
    </div>
  </section>
  <section class="visit-us">
    <section class="service-time-section">
      <table class="time-table">
      <thead>
        <tr>
          <th colspan="2" class="table-title">
            <CalendarIcon class="calendar-icon" width={24} height={24} />
            Service Times
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Sunday School</th>
          <td>10:30 - 11:30</td>
        </tr>
        <tr>
          <th scope="row">Morning Service</th>
          <td>11:30 - 13:00</td>
        </tr>
        <tr>
          <th scope="row">Afternoon Service (Filipino)</th>
          <td>14:00 - 15:00</td>
        </tr>
      </tbody>
    </table>
    </section>
    <section class="location-section">
      <header class="location-header"><LocationIcon width={24} height={24} class="location-icon" /> <h3>Location</h3></header>
      <iframe class="location-content" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2042.0667629209668!2d18.14537527669999!3d59.21489902017553!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465f9dae0722d67b%3A0x165a643e34141b71!2sSmyrna%20Bible%20Baptist%20Church%20-%20Stockholm%20mission!5e0!3m2!1sen!2sse!4v1756428667096!5m2!1sen!2sse" height="250" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </section>
  </section>
  <section class="events">
    
  </section>
</BaseLayout>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--navy);
  }

  .hero-text {
    font-size: 1.25rem;
    margin: 1rem 0;
    color: var(--navy);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cta-button {
    text-decoration: none;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius)
    font-weight: bold;
    color: white;
  }

  .join-info {
    margin-top: 2rem;
  }

  .join-info h3 {
    margin-bottom: 0.5rem;
  }

  .join-info ul {
    list-style: none;
    padding: 0;
  }

  .join-info li {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .join-info li img {
    width: 20px;
    height: 20px;
    margin-right: 0.5rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .list-element {
    font-weight: 800;
  }
  .visit-us {
    display: flex;
    width: 80%;
    gap: 4rem;
    margin-top: 4rem;
  }
  .service-time-section {
    margin-top: -1rem;
    display: flex;
    flex: 1;
  }
  .time-table {
    border-collapse: separate; /* needed for border-spacing to work */
    border-spacing: 0 1rem;
    height:min-content;
    flex: 1; 
  }
  .time-table thead, .location-header {
    height:44px;
    background-color: var(--navy);
    border-radius: var(--radius);
    color: white;
  }

  thead th {
    border-radius: var(--radius);
  }

  tbody th,tbody td {
    text-align: start;
  }

  .table-title, .location-header>h3 {
    font-size: var(--heading3);
  }

  .calendar-icon {
    margin-inline-end: 1rem;
    vertical-align:text-top;
  }
  .location-section{
    flex: 1;
  }
  .location-icon {
    margin-inline-end: 1rem;
    vertical-align:text-top;
  }

  .location-header {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .location-content {
    width: 100%;
  }
  @media (max-width: 768px) {
    .hero-section {
      display: flex;
      flex-direction: column-reverse;
    }
    .visit-us {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }
  }
</style>
