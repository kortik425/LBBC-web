---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Prayer Requests"
  content={`Let us pray for you! 
  “Be careful for nothing; but in every thing by prayer and supplication with thanksgiving let your requests be made known unto God.”
(Philippians 4:6)`}
>
  <section class="prayer-request-section">
    <h2>Submit Your Prayer Request</h2>
    <p>We are working to provide a direct contact form. Please feel free to contact us through <a href="mailto:stockholm@nlighthousebbc.org">email</a>.</p>
  </section>
</PageLayout>

<style>
  .prayer-request-section {
    max-width: 600px;
    margin: 2rem auto;
    padding: 1rem;
    background: var(--parchment);
    border-radius: var(--radius);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .prayer-request-form {
    display: flex;
    flex-direction: column;
  }
  .prayer-request-form label {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-weight: bold;
  }
  .prayer-request-form input,
  .prayer-request-form textarea {
    padding: 0.5rem;
    border: 1px solid var(--stone);
    border-radius: var(--radius);
    font-size: 1rem;
  }
  .prayer-request-form button {
    margin-top: 1.5rem;
    align-self: flex-start;
  }
  .form-message {
    margin-top: 1rem;
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    font-weight: 600;
  }
  .form-message.success {
    background: rgba(46, 125, 50, 0.1);
    color: #2e7d32;
    border: 1px solid rgba(46, 125, 50, 0.15);
  }
  .form-message.error {
    background: rgba(211, 47, 47, 0.06);
    color: #d32f2f;
    border: 1px solid rgba(211, 47, 47, 0.12);
  }
</style>
