---
import PageLayout from "../layouts/PageLayout.astro";
import Card from "../components/Card.astro";
import beliefs from "../data/beliefs.json";
---

<PageLayout 
  title="What We Believe"
  content="Our faith is grounded in the Word of God. Below you’ll find the core beliefs that shape who we are and what we do as a church family.">
  <section class="beliefs">
    {
      beliefs.map((belief) => (
        <Card
          title={belief.title}
          verse={belief.verse}
          reference={belief.reference}
        >
          <Fragment set:html={belief.text} />
        </Card>
      ))
    }
  </section>

  <section class="closing">
    <p>
      These statements summarize what we believe the Bible clearly teaches. We
      encourage you to study the Scriptures and see these truths for yourself.
    </p>
  </section>
</PageLayout>

<style>
  .beliefs {
    display: grid;
    gap: 2rem;
    padding: 2rem 0.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .closing {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--navy);
    color: white;
  }
</style>
